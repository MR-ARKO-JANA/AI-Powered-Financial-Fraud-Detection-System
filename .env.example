# ==============================================================================
# FinGuard AI — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ==============================================================================

# ─── Google Gemini GenAI (Optional) ───
# If not set, FinGuard AI runs in offline hybrid ML + Rules mode.
GEMINI_API_KEY="your_google_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# ─── API Authentication ───
# Format: "key1:role1,key2:role2"
# Roles: admin (full access), analyst (read + analyze), viewer (read-only)
# If not set, authentication is DISABLED (development mode).
FINGUARD_API_KEYS="your-secret-admin-key:admin,your-analyst-key:analyst"

# ─── CORS Origins ───
# Comma-separated list of allowed origins for CORS.
# Default: http://localhost:8501,http://127.0.0.1:8501,http://localhost:8000,http://127.0.0.1:8000
FINGUARD_CORS_ORIGINS="http://localhost:8501,http://127.0.0.1:8501,http://localhost:8000,http://127.0.0.1:8000"
