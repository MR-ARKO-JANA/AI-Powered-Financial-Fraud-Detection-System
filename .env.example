# ==============================================================================
# FinGuard AI — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ==============================================================================

# ─── Google Gemini GenAI (Optional) ───
# If not set, FinGuard AI runs in offline hybrid ML + Rules mode.
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL="gemini-2.5-flash"

# ─── API Authentication ───
# Format: "key1:role1,key2:role2"
# Roles: admin (full access), analyst (read + analyze), viewer (read-only)
# If not set, authentication is DISABLED (development mode).
# IMPORTANT: Generate strong keys with: python -c "import secrets; print(secrets.token_urlsafe(36))"
FINGUARD_API_KEYS="REPLACE-WITH-STRONG-ADMIN-KEY:admin,REPLACE-WITH-STRONG-ANALYST-KEY:analyst"

# ─── CORS Origins ───
# Comma-separated list of allowed origins for CORS.
# Default: http://localhost:8501,http://127.0.0.1:8501,http://localhost:8000,http://127.0.0.1:8000
FINGUARD_CORS_ORIGINS="http://localhost:8501,http://127.0.0.1:8501,http://localhost:8000,http://127.0.0.1:8000"

# ─── Batch Processing ───
MAX_BATCH_SIZE=100
